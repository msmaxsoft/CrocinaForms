{
  "name": "crocina-forms",
  "version": "0.1.0",
  "description": "Crocina Forms – WordPress contact form plugin",
  "private": true,
  "scripts": {
    "lint:css": "stylelint \"assets/*.css\"",
    "lint:css:fix": "stylelint --fix \"assets/*.css\"",
    "check:dead-css": "node tools/check-dead-css.js",
    "check:css": "npm run lint:css && npm run check:dead-css",
    "check:css-strict": "npm run lint:css && node tools/check-dead-css.js --fail-on"
  },
  "devDependencies": {
    "css-tree": "^3.1.0",
    "stylelint": "^16.15.0",
    "stylelint-config-standard": "^37.0.0"
  }
}
